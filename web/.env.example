# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- server ---
# Port the control panel listens on.
PORT=3737
# Bind address. 0.0.0.0 = reachable on the LAN AND over Tailscale.
# Set to your Tailscale IP (100.x.y.z) to accept ONLY tailnet traffic.
RDO_BIND=0.0.0.0

# --- auth ---
# The PIN you type on your phone to unlock the panel. Pick something only you know.
RDO_PIN=change-me
# Secret used to sign the session cookie. Generate one with: openssl rand -hex 32
RDO_SESSION_SECRET=change-me-generate-a-random-hex-string
# How long a session stays valid, in hours.
RDO_SESSION_HOURS=720

# --- rdo-solo integration (runs on the gateway) ---
# The rdo-solo binary that flips the filter and reports status.
RDO_BIN=rdo-solo-tui
# Whether to invoke it under sudo (needs the sudoers rule; see systemd/README).
RDO_SUDO=1
# Kernel-log matcher used to count blocks/IPs live while solo is on.
RDO_BLOCK_TAG=RDO_BLOCK

# --- session-drop detection + alerts ---
# Discord webhook for the "session dropped" alert. Empty disables Discord.
RDO_DISCORD_WEBHOOK=
# Turn solo OFF automatically when the session drops, so the console can
# reconnect (the filter would block the reconnect otherwise). 0 to disable.
RDO_AUTO_OFF=1
# Tuning: seconds of silence with Rockstar's network that counts as a drop, and
# seconds of sustained traffic that confirms a real session before arming.
RDO_DROP_SILENCE_SECS=45
RDO_DROP_CONFIRM_SECS=8
# Rockstar/Take-Two service networks used to detect an active session/drop.
# Comma-separated CIDRs. Override if Rockstar changes ranges.
RDO_RSONET_NETS=192.81.240.0/21,199.46.32.0/19,104.255.104.0/21
